{
  "name": "n8n-workflow-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check-updates": "npm outdated",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "typecheck": "tsc --noEmit",
    "validate-env": "tsx scripts/validate-env.ts",
    "prebuild": "npm run validate-env",
    "db:setup": "tsx scripts/setup-database.ts",
    "db:setup:manual": "tsx scripts/manual-db-setup.ts",
    "db:verify": "tsx scripts/verify-database.ts",
    "test:db": "tsx scripts/test-database.ts",
    "verify:supabase": "node -r dotenv/config scripts/verify-supabase.ts dotenv_config_path=.env.local",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern=__tests__",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:integration": "tsx scripts/run-integration-tests.ts",
    "test:discovery": "tsx scripts/test-discovery-phase-integration.ts",
    "test:config": "tsx scripts/test-configuration-phase-integration.ts",
    "test:build": "tsx scripts/test-building-phase-integration.ts",
    "test:multi-phase": "tsx scripts/test-multi-phase-integration.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.24.0",
    "@modelcontextprotocol/sdk": "1.15.1",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@smithery/sdk": "^1.5.4",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.52.1",
    "chalk": "^4.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.294.0",
    "nanoid": "^5.1.5",
    "next": "14.2.30",
    "react": "^18",
    "react-dom": "^18",
    "react-syntax-highlighter": "^15.6.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.0.0",
    "@types/jest": "^29.5.5",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-syntax-highlighter": "^15.5.13",
    "dotenv": "^17.2.1",
    "eslint-config-next": "^15.4.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.3",
    "typescript": "^5"
  }
}
