# =====================================================
# n8n Workflow Builder Environment Variables
# =====================================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control!

# Supabase Configuration (Public)
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anthropic API Configuration (Server-only)
# Get from: https://console.anthropic.com/
# Must start with 'sk-'
ANTHROPIC_API_KEY=sk-ant-api03-...

# MCP Server Configuration (Server-only)
# These are the default values for the n8n MCP server
MCP_SERVER_URL=https://server.smithery.ai/@vincentmcleese/n8n-mcp/mcp
MCP_API_KEY=28d8026f-fad7-4bc6-87c5-9fcacba57fde
MCP_PROFILE=intermediate-cuckoo-DIapDk

# Security (Server-only)
# Generate a random 32+ character string for cron authentication
# You can use: openssl rand -base64 32
CRON_SECRET=your-very-long-random-string-at-least-32-chars

# Runtime Environment (optional)
# Values: development, production, test
# NODE_ENV=development